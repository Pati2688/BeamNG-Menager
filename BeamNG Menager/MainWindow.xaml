<Window x:Class="BeamNGModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeamNG Mod Manager"
        Height="820"
        Width="1500"
        MinHeight="720"
        MinWidth="1250"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Foreground="#F2F4F8">

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#181B22"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#20242D"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2E3440"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9DA7B6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7B61FF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2D2852"/>

        <Style x:Key="SidebarButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="#E9ECF2"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="Padding"
                    Value="16,11"/>
            <Setter Property="Margin"
                    Value="8,3"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#272C36"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#343A47"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="8,8"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground"
                    Value="#EEF1F6"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#272C35"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>
            <Setter Property="RowBackground"
                    Value="{StaticResource PanelBrush}"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#1C2028"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="RowHeaderWidth"
                    Value="0"/>
            <Setter Property="SelectionMode"
                    Value="Single"/>
            <Setter Property="SelectionUnit"
                    Value="FullRow"/>
            <Setter Property="CanUserAddRows"
                    Value="False"/>
            <Setter Property="AutoGenerateColumns"
                    Value="False"/>
            <Setter Property="IsReadOnly"
                    Value="True"/>
            <Setter Property="FontSize"
                    Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#20242D"/>
            <Setter Property="Foreground"
                    Value="#C9D0DB"/>
            <Setter Property="BorderBrush"
                    Value="#2E3440"/>
            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>
            <Setter Property="Padding"
                    Value="10,12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight"
                    Value="42"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#242933"/>
                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="#2D2852"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="8,7"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background"
                    Value="#5A6474"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background"
                    Value="#171A21"/>
            <Setter Property="Foreground"
                    Value="#5A6474"/>
            <Setter Property="Opacity"
                    Value="0.95"/>
            <Style.Triggers>
                <Trigger Property="Orientation"
                         Value="Horizontal">
                    <Setter Property="Height"
                            Value="11"/>
                    <Setter Property="Margin"
                            Value="4,2,4,4"/>
                </Trigger>

                <Trigger Property="Orientation"
                         Value="Vertical">
                    <Setter Property="Width"
                            Value="11"/>
                    <Setter Property="Margin"
                            Value="2,4,4,4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- LEWY PANEL -->
        <Border Grid.Column="0"
                Background="#151820"
                BorderBrush="#2A2F39"
                BorderThickness="0,0,1,0">

            <Grid Margin="12">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="8,12,8,24">

                    <Border Width="46"
                            Height="46"
                            HorizontalAlignment="Left"
                            CornerRadius="12"
                            Background="{StaticResource AccentBrush}">

                        <TextBlock Text="B"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>

                    </Border>

                    <TextBlock Text="BeamNG"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Mod Manager"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"/>

                </StackPanel>

                <StackPanel Grid.Row="1">

                    <TextBlock Text="NAWIGACJA"
                               Foreground="#6F7A8A"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="16,0,0,8"/>

                    <Button x:Name="LibraryButton"
                            Content="Biblioteka modów"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="{StaticResource AccentSoftBrush}"
                            Click="LibraryButton_Click"/>

                    <Button x:Name="DownloadModsButton"
                            Content="Pobieranie modów"
                            Style="{StaticResource SidebarButtonStyle}"
                            IsEnabled="False"
                            Click="DownloadModsButton_Click"/>

                    <Button x:Name="ScanModsButton"
                            Content="Odśwież bibliotekę"
                            Style="{StaticResource SidebarButtonStyle}"
                            IsEnabled="False"
                            Click="ScanModsButton_Click"/>

                    <Button x:Name="CheckUpdatesButton"
                            Content="Sprawdź aktualizacje"
                            Style="{StaticResource SidebarButtonStyle}"
                            IsEnabled="False"
                            Click="CheckUpdatesButton_Click"/>

                </StackPanel>

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,12">

                    <TextBlock Text="NARZĘDZIA"
                               Foreground="#6F7A8A"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="16,0,0,8"/>

                    <Button x:Name="DetectButton"
                            Content="Sprawdź BeamNG"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="DetectButton_Click"/>

                    <Button x:Name="InstallModButton"
                            Content="Zainstaluj mod"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="InstallModButton_Click"/>

                </StackPanel>

                <Border Grid.Row="3"
                        Background="#1D212A"
                        CornerRadius="10"
                        Padding="12"
                        Margin="8,6">

                    <StackPanel>
                        <TextBlock Text="Projekt w budowie"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>

                        <TextBlock Text="Podgląd interfejsu v0.2"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ŚRODEK -->
        <Grid x:Name="LibraryView"
              Grid.Column="1"
              Margin="22,18,18,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Biblioteka modów"
                               FontSize="27"
                               FontWeight="Bold"/>

                    <TextBlock Text="Zarządzaj modami, zgodnością i aktualizacjami"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <Border Grid.Column="1"
                        Background="#1C2028"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,9"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding ElementName=ModsGrid, Path=Items.Count, StringFormat={}{0} modów}"
                               FontWeight="SemiBold"
                               Foreground="#DDE2EA"/>

                </Border>

            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,0,0,12">

                <TextBlock x:Name="StatusText"
                           Text="Najpierw wykryj BeamNG."
                           Foreground="#BBC3CF"
                           TextWrapping="Wrap"/>

            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="1">

                <DataGrid x:Name="ModsGrid"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Visible"
                          CanUserResizeColumns="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Mod"
                                            Binding="{Binding Name}"
                                            Width="1.7*"
                                            MinWidth="180"/>

                        <DataGridTextColumn Header="Źródło"
                                            Binding="{Binding Source}"
                                            Width="1.0*"
                                            MinWidth="115"/>

                        <DataGridTextColumn Header="Typ"
                                            Binding="{Binding Type}"
                                            Width="0.8*"
                                            MinWidth="90"/>

                        <DataGridTextColumn Header="Wersja"
                                            Binding="{Binding ModVersion}"
                                            Width="0.7*"
                                            MinWidth="80"/>

                        <DataGridTextColumn Header="Aktualizacje"
                                            Binding="{Binding UpdateStatus}"
                                            Width="1.05*"
                                            MinWidth="125"/>

                        <DataGridTemplateColumn Header="Kolizje"
                                                Width="1.05*"
                                                MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Background="{Binding ConflictColor}">
                                        <TextBlock Text="{Binding ConflictStatus}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Rozmiar"
                                            Binding="{Binding Size}"
                                            Width="0.65*"
                                            MinWidth="75"/>

                        <DataGridTextColumn Header="Plik zmieniony"
                                            Binding="{Binding Modified}"
                                            Width="1.0*"
                                            MinWidth="125"/>

                        <DataGridTextColumn Header="Stan"
                                            Binding="{Binding Status}"
                                            Width="0.65*"
                                            MinWidth="80"/>

                        <DataGridTemplateColumn Header="Zgodność"
                                                Width="1.25*"
                                                MinWidth="155">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border CornerRadius="6"
                                            Padding="8,4"
                                            HorizontalAlignment="Left">

                                        <Border.Style>
                                            <Style TargetType="Border">

                                                <Setter Property="Background"
                                                        Value="#4C5563"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Compatibility}"
                                                                 Value="Zgodny">
                                                        <Setter Property="Background"
                                                                Value="#237A4B"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Compatibility}"
                                                                 Value="Prawdopodobnie zgodny">
                                                        <Setter Property="Background"
                                                                Value="#9A7B16"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Compatibility}"
                                                                 Value="Ryzyko problemów">
                                                        <Setter Property="Background"
                                                                Value="#B85C1E"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Compatibility}"
                                                                 Value="Niezgodny">
                                                        <Setter Property="Background"
                                                                Value="#A53A43"/>
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Compatibility}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>

                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

        <!-- POBIERANIE MODÓW -->
        <Grid x:Name="DownloadView"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Margin="22,18,22,18"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Repo BeamNG"
                               FontSize="27"
                               FontWeight="Bold"/>

                    <TextBlock Text="24 najnowsze mody — 4 kafelki w rzędzie × 6 rzędów"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="RefreshCatalogButton"
                        Grid.Column="1"
                        Content="Odśwież"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="140"
                        Margin="10,0,0,0"
                        Click="RefreshCatalogButton_Click"/>

            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,0,0,12">

                <TextBlock x:Name="CatalogStatusText"
                           Text="Katalog nie został jeszcze wczytany."
                           Foreground="#BBC3CF"
                           TextWrapping="Wrap"/>

            </Border>

            <Grid Grid.Row="2">

                <Border x:Name="CatalogBrowseView"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="CatalogTiles">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#1C2028"
                                            BorderBrush="#303641"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Margin="7"
                                            Padding="9"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="CatalogTile_Click">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Height="150"
                                                    Background="#242A35"
                                                    CornerRadius="9"
                                                    ClipToBounds="True">

                                                <Grid>
                                                    <TextBlock Text="MOD"
                                                               Foreground="#4C5563"
                                                               FontSize="28"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <Image Source="{Binding ThumbnailUrl}"
                                                           Stretch="UniformToFill"/>
                                                </Grid>

                                            </Border>

                                            <StackPanel Grid.Row="1"
                                                        Margin="2,9,2,7">

                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="#F2F4F8"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="42"/>

                                                <TextBlock Text="{Binding Author}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                            <Button Grid.Row="2"
                                                    Content="Pobierz"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0"
                                                    Padding="10,7"
                                                    Click="DownloadCatalogItem_Click"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Border>

                <Border x:Name="CatalogDetailView"
                        Visibility="Collapsed"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0"
                                    Content="← Wróć do katalogu"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,14"
                                    Click="CatalogDetailBackButton_Click"/>

                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Height="360"
                                        Background="#242A35"
                                        CornerRadius="12"
                                        ClipToBounds="True"
                                        Margin="0,0,20,0">

                                    <Grid>
                                        <TextBlock Text="MOD"
                                                   Foreground="#4C5563"
                                                   FontSize="42"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <Image Source="{Binding ThumbnailUrl}"
                                               Stretch="UniformToFill"/>
                                    </Grid>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top">

                                    <TextBlock Text="{Binding Title}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Author}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="13"
                                               Margin="0,7,0,16"/>

                                    <TextBlock Text="Kategoria"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"/>

                                    <TextBlock Text="{Binding Category}"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,12"/>

                                    <TextBlock Text="Wersja"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"/>

                                    <TextBlock Text="{Binding Version}"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,18"/>

                                    <Button Content="Pobierz i zainstaluj"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0"
                                            Padding="16,10"
                                            Click="DownloadCatalogItem_Click"/>

                                </StackPanel>

                            </Grid>

                            <Border Grid.Row="2"
                                    Background="#1D212A"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,18,0,0">

                                <StackPanel>
                                    <TextBlock Text="Opis"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,9"/>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="#CBD2DC"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </StackPanel>

                            </Border>

                        </Grid>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Grid>

        <!-- PRAWY PANEL SZCZEGÓŁÓW -->
        <Border x:Name="DetailsPanel"
                Grid.Column="2"
                Background="#151820"
                BorderBrush="#2A2F39"
                BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="20"
                            DataContext="{Binding SelectedItem, ElementName=ModsGrid}">

                    <TextBlock Text="Szczegóły moda"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>

                    <Border Height="190"
                            CornerRadius="14"
                            BorderBrush="#343A46"
                            BorderThickness="1"
                            Margin="0,0,0,18">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#312A66"
                                              Offset="0"/>
                                <GradientStop Color="#1D2230"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>

                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="MOD"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="#E8E4FF"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Miniatura moda pojawi się tutaj"
                                           Foreground="#A8B1C0"
                                           FontSize="12"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <TextBlock Text="{Binding Name, TargetNullValue=Wybierz mod z listy}"
                               FontSize="22"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding Source, TargetNullValue=Brak wybranego moda}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,5,0,18"/>

                    <Border Background="#1D212A"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Typ"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>

                                <TextBlock Text="{Binding Type, TargetNullValue=—}"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Wersja"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>

                                <TextBlock Text="{Binding ModVersion, TargetNullValue=—}"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                        </Grid>

                    </Border>

                    <Border Background="#1D212A"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,12">

                        <StackPanel>

                            <TextBlock Text="Aktualizacje"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"/>

                            <TextBlock Text="{Binding UpdateStatus, TargetNullValue=—}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,10"/>

                            <TextBlock Text="Stan pliku"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"/>

                            <TextBlock Text="{Binding Status, TargetNullValue=—}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#1D212A"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,12">

                        <StackPanel>

                            <TextBlock Text="Kolizje"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"/>

                            <TextBlock Text="{Binding ConflictStatus, TargetNullValue=—}"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Margin="0,4,0,5"/>

                            <TextBlock Text="{Binding ConflictDetails, TargetNullValue=Brak danych o kolizjach}"
                                       TextWrapping="Wrap"
                                       Foreground="#C7CED8"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>

                            <Border Height="1"
                                    Background="#303641"
                                    Margin="0,0,0,12"/>

                            <TextBlock Text="Zgodność"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"/>

                            <TextBlock Text="{Binding Compatibility, TargetNullValue=—}"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Margin="0,4,0,8"/>

                            <TextBlock Text="{Binding CompatibilityReason, TargetNullValue=Brak szczegółów analizy}"
                                       TextWrapping="Wrap"
                                       Foreground="#C7CED8"
                                       FontSize="12"/>

                        </StackPanel>

                    </Border>

                    <TextBlock Text="Podgląd obrazu moda i dodatkowe akcje dodamy w następnym kroku."
                               Foreground="#737E8E"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="2,4,2,0"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>