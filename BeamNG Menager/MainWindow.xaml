<Window x:Class="BeamNGModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeamNG Mod Manager"
        Height="720"
        Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="BeamNG Mod Manager"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button x:Name="DetectButton"
                    Content="Wykryj BeamNG"
                    Width="180"
                    Height="40"
                    Margin="5"
                    Click="DetectButton_Click"/>

            <Button x:Name="ScanModsButton"
                    Content="Skanuj mody"
                    Width="180"
                    Height="40"
                    Margin="5"
                    IsEnabled="False"
                    Click="ScanModsButton_Click"/>

            <Button x:Name="InstallModButton"
                    Content="Zainstaluj mod"
                    Width="180"
                    Height="40"
                    Margin="5"
                    IsEnabled="False"
                    Click="InstallModButton_Click"/>

        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text="Najpierw wykryj BeamNG."
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,15,0,15"/>

        <DataGrid x:Name="ModsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Mod"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Źródło"
                                    Binding="{Binding Source}"
                                    Width="145"/>

                <DataGridTextColumn Header="Typ"
                                    Binding="{Binding Type}"
                                    Width="120"/>

                <DataGridTextColumn Header="Wersja moda"
                                    Binding="{Binding ModVersion}"
                                    Width="120"/>

                <DataGridTextColumn Header="Rozmiar"
                                    Binding="{Binding Size}"
                                    Width="100"/>

                <DataGridTextColumn Header="Data"
                                    Binding="{Binding Modified}"
                                    Width="145"/>

                <DataGridTextColumn Header="Stan pliku"
                                    Binding="{Binding Status}"
                                    Width="110"/>

                <DataGridTemplateColumn Header="Zgodność"
                                        Width="190">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Border CornerRadius="5"
                                    Padding="8,4"
                                    Margin="3">

                                <Border.Style>
                                    <Style TargetType="Border">

                                        <Setter Property="Background"
                                                Value="Gray"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Compatibility}"
                                                         Value="Zgodny">
                                                <Setter Property="Background"
                                                        Value="Green"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Compatibility}"
                                                         Value="Prawdopodobnie zgodny">
                                                <Setter Property="Background"
                                                        Value="Goldenrod"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Compatibility}"
                                                         Value="Ryzyko problemów">
                                                <Setter Property="Background"
                                                        Value="DarkOrange"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Compatibility}"
                                                         Value="Niezgodny">
                                                <Setter Property="Background"
                                                        Value="Red"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding Compatibility}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                            </Border>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Powód"
                                    Binding="{Binding CompatibilityReason}"
                                    Width="300"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>