<Window x:Class="BeamNGModManager.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pobieranie modów"
        Height="620"
        Width="860"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#111318"
        Foreground="#F2F4F8">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#181B22"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2E3440"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9DA7B6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7B61FF"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#262B35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#333947"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#8A73FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Pobieranie modów"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Wklej link do moda. Repo BeamNG jest obsługiwane bezpośrednio, a zwykłe linki do plików ZIP mogą pochodzić z dowolnej strony."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,20,0,14">

            <StackPanel>
                <TextBlock Text="Szybkie źródła"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <WrapPanel>
                    <Button Content="Repo BeamNG"
                            Click="OpenBeamNgRepo_Click"/>
                    <Button Content="Nexus Mods"
                            Click="OpenNexus_Click"/>
                    <Button Content="ModDB"
                            Click="OpenModDb_Click"/>
                    <Button Content="ModLand"
                            Click="OpenModLand_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">

            <StackPanel>
                <TextBlock Text="Adres moda lub pliku ZIP"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="UrlTextBox"
                         Height="38"
                         FontSize="14"
                         Padding="10,7"
                         Background="#101319"
                         Foreground="#F2F4F8"
                         BorderBrush="#343B48"
                         BorderThickness="1"
                         CaretBrush="White"/>

                <TextBlock Text="Przykład: https://www.beamng.com/resources/nazwa-moda.12345/ albo bezpośredni link kończący się na .zip"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="2,7,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="DownloadProgress"
                         Height="14"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         VerticalAlignment="Center"
                         Background="#1A1E26"
                         Foreground="{StaticResource AccentBrush}"/>

            <Button x:Name="DownloadButton"
                    Grid.Column="1"
                    Content="Pobierz i zainstaluj"
                    Style="{StaticResource PrimaryButton}"
                    Margin="14,0,0,0"
                    Click="DownloadButton_Click"/>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">

            <StackPanel>
                <TextBlock Text="Status"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="StatusText"
                           Text="Gotowy."
                           Foreground="#C7CED8"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Plik przed instalacją jest pobierany do katalogu tymczasowego i sprawdzany jako archiwum ZIP."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5"
                   Text="Nexus Mods będzie później podłączony przez oficjalne API; obecnie ten ekran obsługuje Repo BeamNG i bezpośrednie linki do plików."
                   Foreground="#707B8B"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="2,14,0,0"/>
    </Grid>
</Window>